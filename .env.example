# 复制为根目录 .env 后填写；本地和服务器各自只维护这一份，勿提交真实 .env。
# 默认本地开发。生产必改：APP_ENV=production、APP_DEBUG=false、API_PORT=18088，
# 并填写真实访问地址、密码、APP_KEY、Collector Token，详见 CONFIGURATION.md。
APP_NAME=SavebERP
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_PRIVATE_NETWORK=true

# API 宿主机端口；nginx.conf 的容器内监听端口固定 8080。
# 服务器旧 ERP 已占用 18080/18081，新生产环境使用 18088。
API_PORT=8080
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
DEPLOY_NETWORK=saveb-production

# 下面两个主机别名在本地与生产 Compose 中均有效。
# 生产 Collector 也要连接此数据库；数据库已经初始化后不要只改密码期待自动改库密码。
DB_CONNECTION=pgsql
DB_HOST=saveb-api-postgres
DB_PORT=5432
DB_DATABASE=saveb
DB_USERNAME=saveb
DB_PASSWORD=CHANGE_ME
REDIS_CLIENT=phpredis
REDIS_HOST=saveb-api-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
FILESYSTEM_DISK=local
MAIL_MAILER=log

# 附件由 Compose 持久化；默认使用镜像内置 Tesseract，也可填独立 OCR 服务。
BUSINESS_ATTACHMENTS_ROOT=/data/attachments
BUSINESS_OCR_URL=
BUSINESS_OCR_LANGUAGES=eng+chi_sim

# 本地 Collector 通过宿主机端口访问；生产改为 http://saveb-collector-api:8080。
SAVEB_COLLECTOR_URL=http://host.docker.internal:18085
SAVEB_COLLECTOR_TOKEN=REPLACE_WITH_SHARED_RANDOM_TOKEN
SAVEB_COLLECTOR_ACCOUNT=default
# 仅首次建立生产管理员时需要；账号已存在时不会重置密码。
RBAC_SEED_ADMIN_PASSWORD=
