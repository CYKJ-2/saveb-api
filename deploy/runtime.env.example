# Server-only .env. Fill placeholders before enabling DEPLOY_ENABLED.
DEPLOY_NETWORK=saveb-production
API_PORT=18080
APP_NAME=SavebERP
APP_ENV=production
APP_DEBUG=false
APP_KEY=REPLACE_WITH_LARAVEL_APP_KEY
APP_TIMEZONE=Asia/Shanghai
APP_URL=https://admin.example.com
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=saveb-api-postgres
DB_PORT=5432
DB_DATABASE=saveb
DB_USERNAME=saveb
DB_PASSWORD=CHANGE_ME
REDIS_CLIENT=phpredis
REDIS_HOST=saveb-api-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
FRONTEND_URL=https://admin.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com
BUSINESS_ATTACHMENTS_ROOT=/data/attachments
BUSINESS_OCR_LANGUAGES=eng+chi_sim
SAVEB_COLLECTOR_URL=http://saveb-collector-api:8080
SAVEB_COLLECTOR_TOKEN=REPLACE_WITH_SHARED_RANDOM_TOKEN
SAVEB_COLLECTOR_ACCOUNT=default
