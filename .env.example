# ============================================================
# SAVEB ERP API - 环境配置参考
# ============================================================
#
# ⚠️  不要直接修改此文件！
#
# 当前结构：
#   .env 是符号链接 → build/env/.local.env (本地) 或 .prod.env (生产)
#
# 切换环境：
#   本地开发：mklink .env build\env\.local.env
#   生产部署：mklink .env build\env\.prod.env
#
# 查看 build/env/ 下的完整配置文件：
#   - build/env/.local.env   — 本地开发配置
#   - build/env/.prod.env    — 生产环境配置
#
# ⚠️ .env 不要提交到 git（已在 .gitignore 中）
#
# ============================================================

# 此文件仅供参考，实际配置在 build/env/ 目录下
# 下面是常用配置的注释参考：

# APP_NAME=SavebERP
# APP_ENV=local
# APP_DEBUG=true
# APP_TIMEZONE=Asia/Shanghai
# APP_URL=http://localhost:8080

# Docker 镜像配置
# IMAGE_REGISTRY=ghcr.io/YOUR_ORG
# IMAGE_TAG=latest

# PostgreSQL 数据库
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=saveb_erp
# DB_USERNAME=saveb
# DB_PASSWORD=your_password

# Redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=redis
# REDIS_PASSWORD=your_redis_password
# REDIS_PORT=6379
