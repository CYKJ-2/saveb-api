# Copy to .prod.env and fill private values locally; never commit the real environment file.
# Generate APP_KEY with Laravel; use the same private Collector token on both services.
IMAGE_REGISTRY=ghcr.io/YOUR_ORG
IMAGE_TAG=latest
APP_NAME=SavebERP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
APP_URL=https://api.example.com
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=saveb
DB_USERNAME=saveb
DB_PASSWORD=CHANGE_ME
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
FRONTEND_URL=https://admin.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com
CORS_ALLOW_PRIVATE_NETWORK=false
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=SavebERP
UPLOAD_DISK=local
MAX_UPLOAD_SIZE=51200
NGINX_PORT=8080
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
CACHE_STORE=redis
SAVEB_COLLECTOR_URL=http://saveb-collector-api:8080
SAVEB_COLLECTOR_TOKEN=
SAVEB_COLLECTOR_ACCOUNT=default
