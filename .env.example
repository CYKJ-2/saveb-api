# UTF-8，无 BOM。此模板默认用于 Linux 服务器；复制为 .env 后填写必填项。
# 本地和服务器使用相同字段，各自保留不同的值；不要将真实 .env 提交 Git。
# 【必填】APP_KEY、DB_PASSWORD、REDIS_PASSWORD、SAVEB_COLLECTOR_TOKEN。
# 已有数据库必须保留对应 APP_KEY 和数据库凭据，不要重新生成来替换原值。

# 应用：服务器 production / false；本地开发 local / true。
APP_NAME=SavebERP
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# 访问入口：暂无域名，先通过 SSH 隧道访问 http://127.0.0.1:13000。
# 有域名后将下面三个地址改为实际入口；CORS 多个地址用英文逗号分隔。
# 本地通常为 APP_URL=http://localhost:8080，其余两个为 http://localhost:3000。
APP_URL=http://127.0.0.1:13000
FRONTEND_URL=http://127.0.0.1:13000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:13000
CORS_ALLOW_PRIVATE_NETWORK=true

# 宿主机端口：生产 API=18088，本地 API=8080；Nginx 容器内仍监听 8080。
API_PORT=18088
DEPLOY_NETWORK=saveb-production
# PostgreSQL 映射端口用于 Navicat；避开旧数据库占用的 5432。
# 仅生产 infra 使用：服务器内网直连填 192.168.11.84；本地保留 127.0.0.1。
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=5433
# 仅本地开发 Redis 使用；生产 Redis 不映射宿主机端口。
REDIS_HOST_PORT=6380

# 仅生产基础设施 Compose 使用；两个 Redis 服务共用 INFRA_REDIS_IMAGE。
# Docker Hub 超时时可分别改为以下 Docker 官方 ECR Public 地址：
# public.ecr.aws/docker/library/postgres:16-alpine
# public.ecr.aws/docker/library/redis:7-alpine
INFRA_POSTGRES_IMAGE=postgres:16-alpine
INFRA_REDIS_IMAGE=redis:7-alpine

# 【必填密码】API 和 Collector 必须连接同一个业务库。
# 这些主机名适用于 Docker 容器之间；从宿主机连接使用其映射端口。
DB_CONNECTION=pgsql
DB_HOST=saveb-api-postgres
DB_PORT=5432
DB_DATABASE=saveb
DB_USERNAME=saveb
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# 【必填密码】API 专用 Redis；不要填 Collector Redis 的地址。
REDIS_CLIENT=phpredis
REDIS_HOST=saveb-api-redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# 日志；下面保留天数分别用于访问、SQL、SQL 错误和应用错误日志。
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_ACCESS_DAYS=30
LOG_SQL_DAYS=10
LOG_SQL_ERROR_DAYS=30
LOG_ERROR_DAYS=30

# 文件和邮件：当前邮件只写日志，不需要 SMTP 账号。
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# 业务附件使用持久化卷。上传大小由 docker/business-uploads.ini 和 nginx.conf 控制。
# OCR_URL 留空使用镜像内的 Tesseract；使用独立 OCR 服务时才填写 URL。
BUSINESS_ATTACHMENTS_ROOT=/data/attachments
BUSINESS_OCR_URL=
BUSINESS_OCR_BINARY=tesseract
BUSINESS_OCR_LANGUAGES=eng+chi_sim

# 【必填 Token】与 Collector 的 SAVEB_API_TOKEN 完全相同，至少 32 个随机字符。
# 生产使用下面的容器地址；本地原生 Collector 按实际端口填写 host.docker.internal。
SAVEB_COLLECTOR_URL=http://saveb-collector-api:8080
SAVEB_COLLECTOR_TOKEN=REPLACE_WITH_SHARED_RANDOM_TOKEN
SAVEB_COLLECTOR_ACCOUNT=default
